# Copy to .env.local and fill in local backend values from the Supabase status command.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix secret credentials with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Local application URL. Use the real HTTPS application origin when deploying.
APP_ORIGIN=http://127.0.0.1:3200

# Local demo bootstrap generates its own credentials in .env.local.
LOCAL_DEMO=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=56331

# Generated by the encrypted local backup command. Store the key separately.
BACKUP_ENCRYPTION_KEY=
