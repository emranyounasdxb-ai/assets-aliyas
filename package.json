{
  "name": "assets-aliyas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Property and rental management for the company's Ajman buildings",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome lint . --error-on-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "node scripts/start-backend.mjs",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "tools:verify": "node scripts/verify-tools.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-table": "9.3.1",
    "date-fns": "4.4.0",
    "geist": "1.9.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
